{
  "name": "kku-ui",
  "version": "0.9.9982",
  "packageManager": "pnpm@10.5.2",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/es/index.d.ts",
      "import": "./lib/es/index.js"
    },
    "./hooks": {
      "types": "./lib/es/common/hooks/index.d.ts",
      "import": "./lib/es/hooks.js"
    },
    "./index.css": "./lib/index.css",
    "./base.css": "./lib/base.css",
    "./package.json": "./package.json"
  },
  "types": "lib/es/index.d.ts",
  "files": [
    "lib"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "react",
    "react UI",
    "UI Library"
  ],
  "scripts": {
    "sb": "storybook dev -p 6006",
    "build": "biome lint && vitest --run && vite build && pnpm build:base-css",
    "build:base-css": "tailwindcss -i src/styles/base.css -o lib/base.css --minify",
    "publish": "npm publish --access public",
    "test": "vitest",
    "test-coverage": "vitest run --coverage",
    "test-ui": "vitest --ui",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report",
    "e2e:codegen": "playwright codegen http://localhost:6006"
  },
  "pnpm": {
    "overrides": {
      "rollup": "4.44.2"
    }
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": ">=0.400.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@biomejs/biome": "2.5.15",
    "@chromatic-com/storybook": "^5.5.1",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-links": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "^3.1.2",
    "autoprefixer": "^10.4.23",
    "chromatic": "^10.7.1",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.562.0",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^19.2.3",
    "sass": "^1.86.3",
    "storybook": "^10.6.2",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.1",
    "typescript": "5.3.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
